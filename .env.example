# Zyte
ZYTE_API_KEY=your_zyte_api_key_here
# Per-call HTTP timeout in seconds. A hung Zyte request will be aborted
# after this many seconds (Python-level future.result timeout, independent
# of aiohttp's internal ClientTimeout). Default 60s.
ZYTE_API_TIMEOUT=60

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tcg-platform

# tcg-raw bucket — persistent raw HTML/images for replayable scrapes (M9-T1)
RAW_ENDPOINT=localhost:9000
RAW_ACCESS_KEY=minioadmin
RAW_SECRET_KEY=minioadmin
RAW_BUCKET=tcg-raw

# SQLite DBs (per region)
SQLITE_PATH_DE=./data/tcg_de.db
SQLITE_PATH_UK=./data/tcg_uk.db
SQLITE_PATH_US=./data/tcg_us.db

# Exchange rates
CURRENCY_RATES_DB=./data/currency_rates.db